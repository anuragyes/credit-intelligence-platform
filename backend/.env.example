# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Postgres). For local docker-compose this matches docker-compose.yml ---
DATABASE_URL="postgresql://credituser:creditpass@localhost:5432/credit_intelligence?schema=public"

# --- Redis (optional). If unset, the pipeline runs inline instead of via a BullMQ queue. ---
REDIS_URL=

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- AI layer (optional). If unset, extraction/narrative agents fall back to deterministic
# template-based behaviour over the curated source data instead of calling an LLM. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Pipeline mode: "inline" (default, no Redis needed) or "queue" (requires REDIS_URL) ---
PIPELINE_MODE=inline
